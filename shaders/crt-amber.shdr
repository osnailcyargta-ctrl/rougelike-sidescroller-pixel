/*@theme
{
  "name": "Amber Terminal",
  "bgFar": "#140a02", "bgMid": "#1c0e03", "bgNear": "#241304",
  "fog": "#3a1e06", "ground": "#3a1e06", "groundTop": "#ffb347",
  "groundEdge": "#ffd08a", "platform": "#42230a", "platformTop": "#ffb347",
  "platformGlow": "#ffcc7a", "player": "#fff2d6", "cloth": "#ff9c1a",
  "clothDark": "#a35a00", "skin": "#ffd9a0", "steel": "#ffe6bf",
  "enemyGrunt": "#ff7a00", "enemyBrute": "#c24a00", "enemyStinger": "#ffd166",
  "ui": "#ffdca8", "uiDim": "#b07b3a", "uiAccent": "#ffb347", "uiPanel": "#1a0d02",
  "hp": "#ff8c1a", "star": "#ffcc7a",
  "bloomStrength": 1.35, "bloomThreshold": 0.5, "vignette": 0.85,
  "chroma": 0.15, "scanline": 0.65, "saturation": 0.35
}
@*/
// Curved amber phosphor CRT with rolling flicker.
precision mediump float;
varying vec2 vUv;
uniform sampler2D uScene;
uniform sampler2D uBloom;
uniform vec2  uResolution;
uniform float uTime;
uniform float uBloomStrength;
uniform float uVignette;
uniform float uScanline;
uniform float uHit;

vec2 curve(vec2 uv) {
  uv = uv * 2.0 - 1.0;
  uv *= vec2(1.0 + pow(abs(uv.y) * 0.28, 2.0), 1.0 + pow(abs(uv.x) * 0.22, 2.0));
  return uv * 0.5 + 0.5;
}

void main() {
  vec2 uv = curve(vUv);
  if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
    gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
    return;
  }
  vec3 col = texture2D(uScene, uv).rgb + texture2D(uBloom, uv).rgb * uBloomStrength;
  float l = dot(col, vec3(0.299, 0.587, 0.114));
  vec3 amber = vec3(1.0, 0.62, 0.18) * l * 1.25;
  amber += vec3(0.9, 0.2, 0.0) * uHit;

  float scan = 1.0 - uScanline * 0.55 * (0.5 + 0.5 * sin(uv.y * uResolution.y * 3.14159));
  amber *= scan;
  amber *= 0.97 + 0.03 * sin(uTime * 20.0 + uv.y * 8.0);

  vec2 c = uv - 0.5;
  amber *= 1.0 - uVignette * dot(c, c) * 1.3;
  gl_FragColor = vec4(amber, 1.0);
}
