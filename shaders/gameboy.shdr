/*@theme
{
  "name": "Pocket Green",
  "bgFar": "#0f380f", "bgMid": "#173f17", "bgNear": "#204d20",
  "fog": "#2a5a2a", "ground": "#306230", "groundTop": "#8bac0f",
  "groundEdge": "#9bbc0f", "platform": "#306230", "platformTop": "#8bac0f",
  "platformGlow": "#9bbc0f", "player": "#e0f8d0", "playerDark": "#8bac0f",
  "playerAccent": "#e0f8d0", "cloth": "#8bac0f", "clothDark": "#306230",
  "skin": "#e0f8d0", "steel": "#e0f8d0", "steelDark": "#8bac0f",
  "enemyGrunt": "#306230", "enemyBrute": "#0f380f", "enemyStinger": "#8bac0f",
  "enemyDark": "#0f380f", "eye": "#e0f8d0", "fire": "#9bbc0f",
  "fireHot": "#e0f8d0", "spark": "#e0f8d0", "blood": "#306230",
  "lightning": "#e0f8d0", "slime": "#8bac0f", "ui": "#e0f8d0",
  "uiDim": "#8bac0f", "uiAccent": "#9bbc0f", "uiPanel": "#0f380f",
  "hp": "#9bbc0f", "hpBack": "#0f380f", "star": "#8bac0f",
  "bloomStrength": 0.25, "bloomThreshold": 0.8, "vignette": 0.35,
  "chroma": 0.0, "scanline": 0.0, "saturation": 0.0, "animSpeed": 0.9
}
@*/
// Four-tone dithered handheld look.
precision mediump float;
varying vec2 vUv;
uniform sampler2D uScene;
uniform sampler2D uBloom;
uniform vec2  uResolution;
uniform float uTime;
uniform float uBloomStrength;
uniform float uVignette;
uniform float uHit;

const vec3 C0 = vec3(0.059, 0.220, 0.059);
const vec3 C1 = vec3(0.188, 0.384, 0.188);
const vec3 C2 = vec3(0.545, 0.675, 0.059);
const vec3 C3 = vec3(0.878, 0.973, 0.816);

float dither(vec2 p) {
  // 4x4 bayer
  int x = int(mod(p.x, 4.0));
  int y = int(mod(p.y, 4.0));
  int i = x + y * 4;
  float t = 0.0;
  if (i == 0)  t = 0.0;   else if (i == 1)  t = 8.0;  else if (i == 2)  t = 2.0;
  else if (i == 3)  t = 10.0; else if (i == 4)  t = 12.0; else if (i == 5)  t = 4.0;
  else if (i == 6)  t = 14.0; else if (i == 7)  t = 6.0;  else if (i == 8)  t = 3.0;
  else if (i == 9)  t = 11.0; else if (i == 10) t = 1.0;  else if (i == 11) t = 9.0;
  else if (i == 12) t = 15.0; else if (i == 13) t = 7.0;  else if (i == 14) t = 13.0;
  else t = 5.0;
  return t / 16.0 - 0.5;
}

void main() {
  vec3 col = texture2D(uScene, vUv).rgb + texture2D(uBloom, vUv).rgb * uBloomStrength;
  col += vec3(0.4) * uHit;
  float l = dot(col, vec3(0.299, 0.587, 0.114));
  vec2 px = vUv * uResolution;
  l += dither(px) * 0.16;

  vec3 outc = C0;
  if (l > 0.25) outc = C1;
  if (l > 0.50) outc = C2;
  if (l > 0.75) outc = C3;

  vec2 c = vUv - 0.5;
  outc *= 1.0 - uVignette * dot(c, c) * 0.9;
  gl_FragColor = vec4(outc, 1.0);
}
