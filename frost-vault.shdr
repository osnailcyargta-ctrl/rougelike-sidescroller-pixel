/*@theme
{
  "name": "Frost Vault",

  "bgFar":  "#03070f", "bgMid":  "#071426", "bgNear": "#0d2440",
  "fog":    "#16385c", "star":   "#cdf3ff",

  "ground": "#12293f", "groundTop": "#5fa8c9", "groundEdge": "#a8f0ff",
  "platform": "#173347", "platformTop": "#6fbcd8", "platformGlow": "#8fe8ff",

  "player": "#ffffff", "playerDark": "#8fb8cf", "playerAccent": "#9fe8ff",
  "cloth": "#2f6f9e", "clothDark": "#17405e", "skin": "#e8cdb4",
  "steel": "#eaf8ff", "steelDark": "#8fb8cf",

  "enemyGrunt": "#4fd3ff", "enemyBrute": "#7b6bff", "enemyStinger": "#5affd6",
  "enemyDark": "#08172a", "eye": "#ffffff",

  "fire": "#7fd6ff", "fireHot": "#e8fbff", "spark": "#cdf3ff",
  "blood": "#6fd0ff", "lightning": "#dff8ff", "slime": "#8ff5d0",

  "ui": "#e8fbff", "uiDim": "#6f9ab5", "uiAccent": "#8fe8ff", "uiPanel": "#061424",
  "hp": "#6fd0ff", "hpBack": "#0b2035",

  "bloomStrength": 1.15, "bloomThreshold": 0.55,
  "vignette": 0.6, "chroma": 0.25, "scanline": 0.06, "saturation": 0.78,
  "animSpeed": 0.92, "wobble": 0.7, "trail": 1.5
}
@*/
// Frost Vault
// Seen through a pane of ice: the glass refracts in slow cells, frost creeps in
// from the corners, and every bright thing throws a cold six-point flare.
precision mediump float;

varying vec2 vUv;
uniform sampler2D uScene;
uniform sampler2D uBloom;
uniform vec2  uResolution;
uniform float uTime;
uniform float uBloomStrength;
uniform float uVignette;
uniform float uChroma;
uniform float uScanline;
uniform float uSaturation;
uniform float uHit;
uniform float uSlowmo;

float hash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

// cheap value noise
float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// distance to the nearest cell edge - the "cracks" in the ice
float cells(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  float best = 8.0;
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 g = vec2(float(x), float(y));
      vec2 o = vec2(hash(i + g), hash(i + g + 17.3));
      float d = length(g + o - f);
      best = min(best, d);
    }
  }
  return best;
}

void main() {
  vec2 uv = vUv;
  vec2 c = uv - 0.5;
  float r2 = dot(c, c);

  // slow refraction through the ice cells
  vec2 cellUv = uv * vec2(uResolution.x / uResolution.y, 1.0) * 7.0;
  float d = cells(cellUv + uTime * 0.06);
  vec2 refract = vec2(
    cells(cellUv + vec2(0.06, 0.0) + uTime * 0.06) - d,
    cells(cellUv + vec2(0.0, 0.06) + uTime * 0.06) - d
  );
  uv += refract * 0.035;

  vec2 off = c * r2 * 0.012 * uChroma;
  vec3 col;
  col.r = texture2D(uScene, uv - off).r;
  col.g = texture2D(uScene, uv).g;
  col.b = texture2D(uScene, uv + off * 1.4).b;

  vec3 bloom = texture2D(uBloom, uv).rgb;
  col += bloom * uBloomStrength * vec3(0.72, 0.98, 1.30);

  // anisotropic flare: bloom smeared along three axes makes cold starbursts
  vec3 flare = vec3(0.0);
  for (int i = 1; i <= 6; i++) {
    float s = float(i) * 0.006;
    flare += texture2D(uBloom, uv + vec2(s, 0.0)).rgb;
    flare += texture2D(uBloom, uv - vec2(s, 0.0)).rgb;
    flare += texture2D(uBloom, uv + vec2(s, s) * 0.7).rgb;
    flare += texture2D(uBloom, uv - vec2(s, s) * 0.7).rgb;
  }
  col += flare * 0.035 * vec3(0.7, 0.95, 1.25);

  float l = dot(col, vec3(0.299, 0.587, 0.114));
  col = mix(vec3(l), col, uSaturation);
  // lift the shadows to a blue-grey, like light scattering inside the ice
  col = mix(col, col * vec3(0.78, 0.94, 1.18) + vec3(0.02, 0.05, 0.09), 0.65);

  // frost crystals creeping in from the corners
  float frostMask = smoothstep(0.10, 0.42, r2);
  float crystal = 1.0 - smoothstep(0.0, 0.10, cells(cellUv * 1.6));
  float grain = noise(uv * uResolution * 0.35);
  col += vec3(0.55, 0.78, 0.95) * crystal * frostMask * 0.24;
  col += vec3(0.30, 0.45, 0.60) * grain * frostMask * 0.10;

  // hits crack the pane and flash cold, not red
  col += vec3(0.35, 0.60, 0.85) * uHit;
  col += vec3(0.5, 0.8, 1.0) * crystal * uHit * 0.7;

  // slow motion frosts the whole frame over
  col = mix(col, mix(col, vec3(0.72, 0.86, 1.0), 0.35) + crystal * 0.12, uSlowmo);

  float scan = 1.0 - uScanline * (0.5 + 0.5 * sin(uv.y * uResolution.y * 3.14159));
  col *= scan;
  col *= 1.0 - uVignette * r2 * 1.05;

  gl_FragColor = vec4(col, 1.0);
}
